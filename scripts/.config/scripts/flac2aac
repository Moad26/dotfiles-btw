#!/usr/bin/env bash
set -euo pipefail

src="${1:?Usage: $0 <source_dir> <dest_dir>}"
dst="${2:?Usage: $0 <source_dir> <dest_dir>}"
src="${src%/}"

find "$src" -type f -name '*.flac' -print0 | while IFS= read -r -d '' in; do
  rel="${in#"$src"/}"
  out="$dst/${rel%.flac}.m4a"
  cover="$(dirname "$in")/cover.jpg"

  [[ -e "$out" ]] && continue
  mkdir -p "$(dirname "$out")"

  if [[ -f "$cover" ]]; then
    ffmpeg -nostdin -loglevel error -i "$in" -i "$cover" \
      -map 0:a -map 1:v -map_metadata 0 \
      -c:a aac -b:a 256k \
      -c:v copy -disposition:v:0 attached_pic \
      "$out"
  else
    ffmpeg -nostdin -loglevel error -i "$in" \
      -vn -map_metadata 0 -c:a aac -b:a 256k "$out"
  fi
  echo "converted: $rel"
done
